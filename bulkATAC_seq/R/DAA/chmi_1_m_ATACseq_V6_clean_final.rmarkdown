```{r input files}
# Input files
peak_file <- "/working_groups/boylelab/shared/ZulyPava/formating4hpc/ATACseq_analysis/featurecounts/chmi_1_m_featurecounts/filtered_peaks.bed"
raw_count_file <- "/working_groups/boylelab/shared/ZulyPava/formating4hpc/ATACseq_analysis/featurecounts/chmi_1_m_featurecounts/peak_counts.txt"
sample_key_file <- "/working_groups/boylelab/shared/ZulyPava/ATACseq_R4.4/ATAC_seq/output/chmi_1_m/sample_fastqname_key.csv"
