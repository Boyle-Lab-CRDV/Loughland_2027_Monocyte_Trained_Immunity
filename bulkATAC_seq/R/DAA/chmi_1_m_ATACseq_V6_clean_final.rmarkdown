```{r checking what the svs correlate with}
sv1 <- as.numeric(metadata_all$sv1)

# numeric variables
cors <- cor(sv1, metadata_all[, c("sv2", "sv3", "sv4")],
            use = "pairwise.complete.obs")

r2 <- cors^2
r2
# categorical variables
summary(lm(sv1 ~ sv2, data = metadata_all))
summary(lm(sv1 ~ sv3, data = metadata_all))
summary(lm(sv1 ~ sv4, data = metadata_all))
summary(lm(sv2 ~ sv3, data = metadata_all))
summary(lm(sv2 ~ sv4, data = metadata_all))
summary(lm(sv3 ~ sv4, data = metadata_all))

# categorical variables
summary(lm(sv1 ~ batch, data = metadata_all))#sv1 corr with batch
summary(lm(sv1 ~ Factor, data = metadata_all))
summary(lm(sv1 ~ sample, data = metadata_all))#sv1 corr with one sample l(very low)

# categorical variables
summary(lm(sv2 ~ batch, data = metadata_all))
summary(lm(sv2 ~ Factor, data = metadata_all))
summary(lm(sv2 ~ sample, data = metadata_all))#sv1 corr with one sample l(very low)
#None corr

# categorical variables
summary(lm(sv3 ~ batch, data = metadata_all))
summary(lm(sv3 ~ Factor, data = metadata_all))
summary(lm(sv3 ~ sample, data = metadata_all))
# categorical variables
summary(lm(sv4 ~ batch, data = metadata_all))#sv1 corr with batch
summary(lm(sv4 ~ Factor, data = metadata_all))
summary(lm(sv4 ~ sample, data = metadata_all))#sv1 corr with one sample l(very low)

```

```{r Final dream model}
param <- SnowParam(8, "SOCK", progressbar = TRUE) # rstudio server doesn't like parallele processing

metadata_all$samples <- factor(metadata_all$sample)
metadata_all$group   <- factor(metadata_all$Factor, levels = c("d0", "d8", "d27"))
metadata_all$group   <- relevel(metadata_all$group, ref = c("d0"))

#expluding sv1 and sv4
form3 <- ~ group + batch + sv3 + sv4 + (1|samples)

vobjDream <- voomWithDreamWeights(
  dgelist,
  form3,
  metadata_all,
  plot = FALSE
)
saveRDS(vobjDream,"/working_groups/boylelab/shared/ZulyPava/ATACseq_R4.4/ATAC_seq/output/chmi_1_m/Variance_analysis/vobjDream_200426.rds" )

fitmm3 <- dream(vobjDream, form3, metadata_all)
fitmm3 <- eBayes(fitmm3)

saveRDS(
  fitmm3,
  file.path(out_dir, "Dream_fitmm3_group_3sv_batch_ci95_200426.rds")
)

```

```{r Save differential accessibility results}
coef_names <- colnames(coef(fitmm3))

top_tables <- lapply(coef_names, function(coef_name) {
  tt <- topTable(
    fitmm3,
    coef = coef_name,
    sort.by = "none",
    confint = 0.95,
    number = Inf
  )
  
  tt$GeneID <- rownames(tt)
  tt$Coefficient <- coef_name
  tt
})

names(top_tables) <- coef_names

combined_top_tables <- bind_rows(top_tables)

write.csv(
  combined_top_tables,
  file.path(out_dir, "Dream_fitmm3_group_3sv__batch_ci95_200426.csv"),
  row.names = FALSE
)

head(combined_top_tables %>% filter(Coefficient == "groupd8"&adj.P.Val<0.8))
```

```{r Variance partition}
metadata_all = metadata_all %>%
  mutate(group_num = case_when(Factor == "d0" ~ 0,
                               Factor == "d8" ~ 1,
                               Factor == "d27" ~ 2))

form_vp <- ~ group_num +  batch + sv3 + sv4 + (1 | samples) 

vp <- fitExtractVarPartModel(vobjDream, form_vp, metadata_all)

pdf(file.path(var_dir, "VariancePartitionPlot_200426.pdf"))
plotVarPart(sortCols(vp))
dev.off()
#vp <- readRDS(file.path(var_dir, "vp_obj.rds"))
saveRDS(vp, file.path(var_dir, "vp_obj.rds"))

plotVarPart(sortCols(vp))
```

```{r Batch-corrected PCA}
design_pca <- model.matrix(~ group, data = metadata_all)

expr_bc <- removeBatchEffect(
  x = vobjDream$E,
  batch = metadata_all$batch,
  covariates = as.matrix(metadata_all[, c("sv3", "sv4")]),
  design = design_pca
)


res.pca <- prcomp(t(expr_bc), scale. = TRUE)

pca_metadata <- data.frame(
  PC1 = res.pca$x[, 1],
  PC2 = res.pca$x[, 2],
  SampleID = rownames(res.pca$x),
  Group = factor(metadata_all$group),
  Batch = factor(metadata_all$batch),
  Sample = factor(metadata_all$samples)
)

pca_metadata$Group <- gsub("d0", "chmi_d0", pca_metadata$Group)
pca_metadata$Group <- gsub("d8", "chmi_d8", pca_metadata$Group)
pca_metadata$Group <- gsub("d27", "chmi_d27", pca_metadata$Group)
```

```{r plotting the PCA timepoints and batch as shape}
# PCA without batch correction or SV2 removal
res.pca2 <- prcomp(
  t(vobjDream$E),
  center = TRUE,
  scale. = TRUE
)

# Extract PCA coordinates
pca_df <- as.data.frame(res.pca2$x[, 1:2, drop = FALSE])

# Match metadata to PCA sample order
idx <- match(rownames(pca_df), rownames(metadata_all))

# Check that all samples have matching metadata
stopifnot(!anyNA(idx))

pca_metadata2 <- metadata_all[idx, , drop = FALSE]

# Add PCA coordinates to metadata
pca_metadata2$PC1 <- pca_df$PC1
pca_metadata2$PC2 <- pca_df$PC2

# Define batch
pca_metadata2$batch <- factor(pca_metadata2$batch)

# Rename groups, assuming original values are endC and postinfx
pca_metadata2$group <- factor(
  pca_metadata2$group,
  levels = c("d0",  "d8",  "d27"),
  labels = c("chmi_d0", "chmi_d8","chmi_d27")
)

# Verify recoding
table(pca_metadata2$group, useNA = "ifany")
table(pca_metadata2$batch, useNA = "ifany")
# Plot
colz <- c("2"= "#fdae61", "3"="darkgreen")

#colz <- c("d0"= "#bababa", "d8"="#fdae61",  "d15"="darkgreen", "d28"="blue")
#colz <- c("d0"= "darkred", "d8"="darkblue",  "d15"="darkgreen", "d27"="lightblue")

pca_nosva2 <- ggplot(pca_metadata2, aes(x = PC1, y = PC2, color = batch, shape = group)) +  # Added shape = Group
  geom_point(size = 4) +
  xlab(paste0("PC1: ", round(summary(res.pca2)$importance[2,1] * 100, 2), "% variance")) +
  ylab(paste0("PC2: ", round(summary(res.pca2)$importance[2,2] * 100, 2), "% variance")) +
  scale_color_manual(values = colz) +
  scale_shape_manual(values = c(16, 17, 18))+  # Added shape scale
  theme_bw()

# Plot the PCA
pca_nosva2
# Save it
ggsave(pca_nosva2, filename = "/working_groups/boylelab/shared/ZulyPava/ATACseq_R4.4/ATAC_seq/output/chmi_1_m/Variance_analysis/PCA_timepoint_batchShaped_v2_261109.pdf",  width = 7, height = 5, dpi = 600,scale = 1)
pca_nosva2
```

