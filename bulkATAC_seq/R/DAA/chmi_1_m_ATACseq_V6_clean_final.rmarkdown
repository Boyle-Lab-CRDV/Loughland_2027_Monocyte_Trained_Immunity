```{r ATACseq PCA of days with ellipse per sample}
# time-ordered, colorblind-friendly palette
colz3 <- c(
  "chmi_d0" = "#C11C84",  # pink
  "chmi_d8" = "#2E8B57",  # sea green
  "chmi_d27" = "#54278f" # dark goldenrod
)
# matching, slightly lighter fills for ellipses
fillz3 <- lighten(colz3, amount = 0.6)

pca_nosva5 <- ggplot(pca_metadata, aes(PC1, PC2)) +
  # axes
  geom_hline(yintercept = 0, colour = "grey60", linewidth = 0.3) +
  geom_vline(xintercept = 0, colour = "grey60", linewidth = 0.3) +

  # ellipses (filled + outline)
  stat_ellipse(
    aes(color = Group, fill = Group),
    geom   = "polygon",
    alpha  = 0.20,
    linewidth = 0.6,
    level  = 0.95
  ) +

  # sample points: filled symbols with black edge
  geom_point(
    aes(fill = Group, shape = Group),
    size   = 4,
    colour = "black",
    stroke = 0.4
  ) +

  # group means: larger black “x”
stat_summary(
    data = pca_metadata,
    aes(x = PC1, y = PC2, group = Group),
    fun = mean,
    geom = "point",
    shape = 1,
    size = 0,
    stroke = 0,
    inherit.aes = FALSE)+

# labels
  xlab(paste0("PC1: ", round(summary(res.pca)$importance[2, 1] * 100, 2), "% variance")) +
  ylab(paste0("PC2: ", round(summary(res.pca)$importance[2, 2] * 100, 2), "% variance")) +

  # manual scales
  scale_color_manual(values = colz3) +
  scale_fill_manual(values  = fillz3) +
  scale_shape_manual(values = c("chmi_d0" = 21,"chmi_d8" = 21, "chmi_d27" = 21)) +

  # clean theme
  theme_bw(base_size = 11) +
  theme(
    panel.grid.major = element_line(colour = "grey90", linewidth = 0.3),
    panel.grid.minor = element_blank(),
    axis.title = element_text(face = "bold"),
    legend.title = element_blank(),
    legend.background = element_rect(fill = "white", colour = "grey70"),
    legend.key = element_rect(fill = NA)
  )


pdf("/working_groups/boylelab/shared/ZulyPava/ATACseq_R4.4/ATAC_seq/output/chmi_1_m/Variance_analysis/PCA_Peaks_timepoint_chmi_1_m_v2_elipse1_main200426.pdf",  width = 7, height = 5)
pca_nosva5
dev.off()

pca_nosva5
```

```{r ATACseq PCA supp fig days with elipse}
# ###Ellipses by sample ####
colz4 <-c(
  "R11003" = "#8c510a",
  "R102" = "#d8b365",
  "R108" = "#f6e8c3",
  "R11001" = "#c7eae5",
  "R31002" = "#5ab4ac",
  "R105" = "#01665e"
)

fillz4 <- lighten(colz4, amount = 0.6)

pca_nosva6 <- fviz_pca_ind(res.pca,
             label='none',
             alpha.ind = 0.5,
             habillage=pca_metadata$Sample,
             repel = TRUE,
             palette = colz4,
             # Don't use default Ellipses!!!!
             # addEllipses = TRUE,
             invisible='quali') +
  geom_point(aes(shape=pca_metadata$Group, fill=pca_metadata$Sample),size=3) +
  scale_shape_manual(values = c("chmi_d0" = 22, "chmi_d8" = 23, "chmi_d27" = 21)) +
  guides(fill = "none")+
  # ADD ggforce's ellipses
  ggforce::geom_mark_ellipse(aes(color = Groups)) +
  theme_bw(base_size = 11) +
  theme(legend.position = "bottom",
    panel.grid.major = element_line(colour = "grey90", linewidth = 0.5),
    panel.grid.minor = element_blank(),
    axis.title = element_text(face = "bold"),
    legend.title = element_blank(),
    legend.background = element_rect(fill = "white", colour = "grey70"),
    legend.key = element_rect(fill = NA))+
   scale_y_continuous(breaks = seq(-500, 500, by = 250),
                     limits = c(-500, 500)) + # Reversed limits
   coord_fixed(ratio = 1, xlim = c(-500, 850))

