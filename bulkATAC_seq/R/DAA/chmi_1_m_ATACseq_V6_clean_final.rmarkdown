```{r peak annotation}
peaks <- readPeakFile(peak_file)

txdb <- TxDb.Hsapiens.UCSC.hg38.knownGene

peakAnno <- annotatePeak(
  peaks,
  TxDb = txdb,
  tssRegion = c(-3000, 3000),
  annoDb = "org.Hs.eg.db"
)

anno_df <- as.data.frame(peakAnno) %>%
  mutate(GeneID = paste0("peak_", row_number())) %>%
  relocate(GeneID)

write.csv(
  anno_df,
  file.path(out_dir, "annotated_filtered_peaks.csv"),
  row.names = FALSE
)
```

```{r peak annotation plots}
pdf(file.path(plot_dir, "Barplot_distance_TSS_regions.pdf"))
plotDistToTSS(peakAnno)
dev.off()

pdf(file.path(plot_dir, "Pie_genomic_functional_categories.pdf"))
plotAnnoPie(peakAnno)
dev.off()
```

```{r read counts and metadata}
anno_df <- read.csv(file.path(out_dir, "annotated_filtered_peaks.csv"))
raw_counts <- read.table(raw_count_file, header = TRUE)
meta0 <- read.csv(meta_file)

key <- read.csv("/working_groups/boylelab/shared/ZulyPava/ATACseq_R4.4/ATAC_seq/input/chmi_1_m/sample_fastqname_key.csv", row.names = 1)

# Get current column names
current_colnames <- colnames(raw_counts)

# Create a named vector for renaming
rename_map <- setNames(key$New_id, key$old_id)

# Apply renaming where column names match keys
new_colnames <- ifelse(current_colnames %in% names(rename_map),
                       rename_map[current_colnames],
                       current_colnames)

# Assign new column names to the dataframe
colnames(raw_counts) <- new_colnames
colnames(raw_counts)[1] <- "GeneID"
# Merge annotations and counts
counts_df <- left_join(anno_df, raw_counts, by = "GeneID")

write.csv(
  counts_df,
  file.path(out_dir, "annotated_peak_counts.csv"),
  row.names = FALSE
)


```

```{r metadata formatting}
set.seed(12345)

counts_df <- read.csv("/working_groups/boylelab/shared/ZulyPava/ATACseq_R4.4/ATAC_seq/output/chmi_1_m/annotated_peak_counts.csv")

meta0 <- read.csv("/working_groups/boylelab/shared/ZulyPava/ATACseq_R4.4/ATAC_seq/output/chmi_1_m/sample_sheet_DiffBind.csv")

meta = meta0 %>% select(-bamReads, -Peaks) %>% filter(Factor%in%c("d0",  "d8",  "d27"))

# Extract count matrix (remove annotation columns)
rownames(counts_df) <- counts_df$GeneID

counts_df2 <- counts_df %>%
  filter(!seqnames%in%c("chr14_KI270726v1_random",
                        "chr15_KI270727v1_random",
                        "chr16_KI270728v1_random",
                        "chr1_KI270713v1_random",
                        "chr22_KI270733v1_random",
                        "chrUn_GL000219v1",
                        "chrUn_GL000220v1",
                        "chrUn_KI270744v1",
                        "chrX", "chrY"))



# Removing day 15 non-count columns
count_matrix <- counts_df2 %>%
 dplyr::select(-c(1:23), -ends_with("d15"))
# Remove day 15 columns


# Make sure columns match metadata sample names
all(colnames(count_matrix) %in% meta$SampleID)  # Should return TRUE
##Fixing row name to match with count matrix


# Reorder metadata to match count matrix
metadata <- meta[match(colnames(count_matrix), meta$SampleID), ]
rownames(metadata) <- metadata$SampleID

metadata

metadata_all <- metadata %>% rename(batch = Condition)
metadata_all$Factor <- factor(metadata_all$Factor, levels=c("d0",  "d8",  "d27"))
metadata_all$Factor <- relevel(as.factor(metadata_all$Factor), ref = "d0")

```

```{r Create DGEList and filter low-abundance peaks}
dgelist <- DGEList(
  counts = count_matrix,
  group = metadata_all$Factor,
  batch = metadata_all$batch,
  lib.size = colSums(count_matrix),
  samples = metadata_all$SampleID,
  genes = counts_df2$SYMBOL
)

dgelist$samples$batch <- factor(metadata_all$batch)

dgelist$samples$group <- factor(metadata_all$Factor)
dgelist$samples$samples <- factor(metadata_all$SampleID)

# Inspect group sizes
xtabs(~ group, dgelist$samples)
# group
#  d0  d8 d27 
#   6   6   5 
xtabs(~ group + batch, dgelist$samples)
#      batch
# group 2 3
#   d0  3 3
#   d8  3 3
#   d27 2 3

# Filter low-count peaks
sapply(0:5, function(k) sum(rowSums(cpm(dgelist) > k) >= 5))
#> 259643 246927 133336  76436  54612  43772
#> k = 1 keeps 0.9510251 of the data
#> k = 2 keeps 0.5135359 of the data
#> k = 3 keeps 0.2943888 of the data
#> k = 4 keeps 0.210335  of the data
#> k = 5 keeps 0.1685853 of the data

# We use k = 4, keeping 23% of peaks for differential testing. As a point of reference, Greenleaf report most of his data with respect to a set of 50,000 ‘top’ peaks.


keepg <- rowSums(cpm(dgelist) > 4) >= 5
dgelist <- dgelist[keepg, , keep.lib.sizes = FALSE]

# TMM normalization
dgelist <- calcNormFactors(dgelist)

dim(dgelist)
#54613    17
```

```{r Exploratory voom and MDS}
##all the covariates minus the random effect
design_qc <- model.matrix(~ 0 + group + batch, dgelist$samples)
colnames(design_qc) <- colnames(design_qc) %>%
  str_replace("^group", "") %>%
  str_replace("^samples", "")

elist_qc <- voom(dgelist, design_qc, plot = TRUE)

```

```{r MDS by group }
group_cols <- c("d0" = "#74add1", "d8" = "#9e0142","d27"="darkgreen" )

plotMDS(
  elist_qc,
  top = 500,
  labels = paste0(rownames(dgelist$samples), "-", dgelist$samples$group),
  col = group_cols[as.character(dgelist$samples$group)],
  gene.selection = "common",
  main = "MDS coloured by group"
)

legend(
  "bottom",
  legend = names(group_cols),
  col = unname(group_cols),
  pch = 16,
  ncol = 2,
  bty = "n"
)
```

```{r MDS by batch}
batch_cols <- c("1" = "darkgreen", "2" = "#9e0142", "3" = "#74add1")

plotMDS(
  elist_qc,
  top = 500,
  labels = paste0(rownames(dgelist$samples), "-", dgelist$samples$batch),
  col = batch_cols[as.character(dgelist$samples$batch)],
  gene.selection = "common",
  main = "MDS coloured by batch"
)

legend(
  "bottom",
  legend = names(batch_cols),
  col = unname(batch_cols),
  pch = 16,
  ncol = 3,
  bty = "n"
)

```

```{r Surrogate variable analysis}
# Full model for SVA
mod <- model.matrix(~ group + batch , data = dgelist$samples)

# Null model for SVA
mod0 <- model.matrix(~ batch, data = dgelist$samples)

# Estimate number of SVs
n_sv <- num.sv(dat = elist_qc$E, mod = mod, method = "be")
n_sv

#4

svobj <- sva(
  dat = elist_qc$E,
  mod = mod,
  mod0 = mod0,
  n.sv = n_sv
)

# Add first SV to metadata
metadata_all$sv1 <- svobj$sv[, 1]
metadata_all$sv2 <- svobj$sv[, 2]
metadata_all$sv3 <- svobj$sv[, 3]
metadata_all$sv4 <- svobj$sv[, 4]

dgelist$samples$sv1 <- metadata_all$sv1
dgelist$samples$sv2 <- metadata_all$sv2
dgelist$samples$sv3 <- metadata_all$sv3
dgelist$samples$sv4 <- metadata_all$sv4
```

